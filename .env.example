# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
# Values are read at startup by crown-cli only. Anything already
# exported in your shell takes precedence over this file, so you can override a
# single variable for one run without editing it.
#
# Password here is plaintext. The minted Bluetooth token is cached separately
# in the system keyring, not in this file.

NEUROSITY_EMAIL=you@example.com
NEUROSITY_PASSWORD=your-password
NEUROSITY_DEVICE_ID=your-device-id
