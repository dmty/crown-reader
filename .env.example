# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
# Values are read at startup by both crown-cli and crown-qt. Anything already
# exported in your shell takes precedence over this file, so you can override a
# single variable for one run without editing it.
#
# Your Neurosity account password lives here in plaintext. Only the minted
# Bluetooth token is cached in the macOS Keychain; this file is not.

NEUROSITY_EMAIL=you@example.com
NEUROSITY_PASSWORD=your-password
NEUROSITY_DEVICE_ID=your-device-id
